<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>triaxis.Tools.DuckPg</AssemblyName>
    <RootNamespace>triaxis.Tools.DuckPg</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>duckpg</ToolCommandName>
    <PackageId>triaxis.Tools.DuckPg</PackageId>
    <PackageTags>duckdb;postgres;pgwire;parquet;datalake;dotnet-tool</PackageTags>
    <Description>Serves a stack of YAML, JSON and parquet layers over the PostgreSQL wire protocol, backed by DuckDB.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- No AOT publish (the tool ships portable), but the analysers keep the code AOT-clean. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Source-generated configuration binding, so Get<Config>() needs no reflection. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data" Version="1.5.5" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageReference Include="triaxis.CommandLine.Tool" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="triaxis.Tools.DuckPg.Tests" />
  </ItemGroup>

</Project>
