<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DuckDbVersion>1.5.5</DuckDbVersion>
    <IsPackable>false</IsPackable>
    <!-- SqlClient refuses to run in invariant globalization mode; the tool itself has no such need. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>triaxis.DuckPg.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Downloaded, not referenced: only the native library is wanted, and the managed assemblies
         next to it would collide with the ones the tool already brings. -->
    <PackageDownload Include="DuckDB.NET.Bindings.Full" Version="[$(DuckDbVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/triaxis.DuckPg.Cli/triaxis.DuckPg.Cli.csproj" />
  </ItemGroup>

  <!-- The tool links against the DuckDB installed on the machine; the tests carry their own, so a
       clean checkout and a clean CI runner can both run them. -->
  <Target Name="CopyDuckDbNative" BeforeTargets="PrepareForRun">
    <PropertyGroup>
      <!-- macOS ships as one universal binary under `osx`, where every other platform has a folder
           per RID, so the SDK's own `osx-arm64` finds nothing there. -->
      <DuckDbRid Condition="'$(DuckDbRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx</DuckDbRid>
      <DuckDbRid Condition="'$(DuckDbRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</DuckDbRid>
      <DuckDbRuntime>$(NuGetPackageRoot)duckdb.net.bindings.full/$(DuckDbVersion)/runtimes/$(DuckDbRid)/native</DuckDbRuntime>
    </PropertyGroup>
    <ItemGroup>
      <DuckDbNative Include="$(DuckDbRuntime)/*" />
    </ItemGroup>
    <Error Condition="'@(DuckDbNative)' == ''"
           Text="No DuckDB native library in $(DuckDbRuntime): DuckDB.NET.Bindings.Full $(DuckDbVersion) carries none for $(DuckDbRid)." />
    <Copy SourceFiles="@(DuckDbNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
